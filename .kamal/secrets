# Secrets for the PRODUCTION destination (`kamal deploy` with no -d).
#
# Read alongside .kamal/secrets-common, which holds everything shared. This file
# is NOT read when a destination is given — `-d staging` reads
# .kamal/secrets-common + .kamal/secrets.staging instead.
#
# DO NOT ENTER RAW CREDENTIALS HERE. This file is committed.
#
# Production is not provisioned via Kamal yet — see the header of
# config/deploy.yml.

# One password, used both to initialise the Postgres accessory (POSTGRES_PASSWORD
# is read by the postgres image's initdb on first boot) and to authenticate the
# app against it (config/database.yml's production block reads
# SYNDICATE_DEVELOPMENT_2026_DATABASE_PASSWORD). They must match.
POSTGRES_PASSWORD=$PRODUCTION_DATABASE_PASSWORD
SYNDICATE_DEVELOPMENT_2026_DATABASE_PASSWORD=$PRODUCTION_DATABASE_PASSWORD
