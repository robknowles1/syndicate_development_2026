# Committed file: never paste a real credential here — every line reads from the
# deploying shell. See "Secrets" in docs/deployment/ovh-server-access.md.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Do NOT tidy this into ${RAILS_MASTER_KEY:-$(cat config/master.key)}. Dotenv has
# no :- defaults, so that form ships the literal ":-<key>}" as the master key and
# decrypts nothing.
RAILS_MASTER_KEY=$(cat config/master.key 2>/dev/null || printf %s "$RAILS_MASTER_KEY")

RESEND_API_KEY=$RESEND_API_KEY

ADMIN_SEED_PASSWORD=$ADMIN_SEED_PASSWORD
