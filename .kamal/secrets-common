# Secrets shared by every Kamal destination.
#
# DO NOT ENTER RAW CREDENTIALS HERE. This file is committed. Every line below
# reads a value from the deploying shell's environment; nothing is stored.
#
# Kamal reads two files per deploy:
#   no destination  ->  .kamal/secrets-common  +  .kamal/secrets
#   -d staging      ->  .kamal/secrets-common  +  .kamal/secrets.staging
#
# The base .kamal/secrets file is NOT read when a destination is given, which is
# why everything shared lives here.
#
# An unset variable resolves to an empty string rather than an error, so `kamal
# config` will render clean even when nothing is exported, and Kamal writes
# `KEY=` into the container rather than leaving the key out. Confirm the values
# are actually present before deploying. The list is per destination, because
# the database password is not shared:
#
#   # staging — bin/kamal deploy -d staging
#   for v in KAMAL_REGISTRY_PASSWORD RESEND_API_KEY ADMIN_SEED_PASSWORD \
#            STAGING_DATABASE_PASSWORD; do
#     [ -n "${!v}" ] && echo "$v set" || echo "$v MISSING"
#   done
#
#   # production — bin/kamal deploy, no destination (not provisioned yet)
#   for v in KAMAL_REGISTRY_PASSWORD RESEND_API_KEY ADMIN_SEED_PASSWORD \
#            PRODUCTION_DATABASE_PASSWORD; do
#     [ -n "${!v}" ] && echo "$v set" || echo "$v MISSING"
#   done
#
# The database password is the entry these loops used to omit, and it is the
# expensive one to discover late: `kamal accessory boot db -d staging` REPORTS
# SUCCESS whether or not the container survives. It does not wait on it, and the
# postgres:16 image refuses to initdb with an empty POSTGRES_PASSWORD and exits
# at once — leaving a "booted" accessory that is not running, and an app that
# then cannot connect.
#
# KAMAL_REGISTRY_PASSWORD is needed even to boot that accessory, not only to
# deploy the app: Kamal::Cli::Accessory#prepare runs `docker login` against the
# ROOT registry config before it pulls postgres:16.
#
# RAILS_MASTER_KEY is missing from both loops on purpose — on a workstation the
# line below reads config/master.key and the variable is not needed. In CI that
# file does not exist and the variable is mandatory, which is why the deploy job
# in .github/workflows/ci.yml checks it along with the other five before it runs
# Kamal at all.

# GitHub Container Registry token (a PAT with write:packages, or a
# GITHUB_TOKEN in CI). Never commit it.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Decrypts config/credentials.yml.enc, which holds secret_key_base. The app
# cannot boot without it. Reads the local key file on a workstation and falls
# back to the environment for a CI deploy, where config/master.key is absent
# (.gitignore excludes config/*.key).
#
# Do not rewrite this as ${RAILS_MASTER_KEY:-$(cat config/master.key)}. Dotenv
# does not implement :- defaults, so that form resolves to the literal string
# ":-<key>}" and ships a master key that cannot decrypt anything.
RAILS_MASTER_KEY=$(cat config/master.key 2>/dev/null || printf %s "$RAILS_MASTER_KEY")

# Resend SMTP password. config/application.rb falls back to the encrypted
# credential resend.api_key, but that key is absent from credentials on this
# branch, so the environment variable is currently mandatory.
RESEND_API_KEY=$RESEND_API_KEY

# Seeds the first admin user, via db/seeds.rb on the one deploy whose
# `db:prepare` actually creates the database.
#
# A missing or empty value does NOT stop the deploy, despite the `raise` in
# db/seeds.rb. ENV.fetch runs its block only when the key is ABSENT, and an
# empty export is present-and-empty, so fetch returns "". has_secure_password's
# writer then no-ops on a blank password, the record is invalid, and the
# NON-bang find_or_create_by returns it unsaved without raising. `db:prepare`
# exits 0, the server starts, the health check passes, and there is simply no
# admin account. Re-deploying does not retry it either: seeds run only for a
# database the same run created.
#
# Use 12-72 bytes.
#
# The upper bound is bcrypt's and IS enforced — has_secure_password adds a
# :password_too_long validation above 72 bytes, and an over-long value fails the
# same silent way an empty one does.
#
# The lower bound is NOT enforced by the application on this branch or on main:
# app/models/admin_user.rb carries no length validation. It is a convention, and
# the only place it is currently checked is the pre-flight step in
# .github/workflows/ci.yml, which covers CI deploys only. On a workstation
# nothing checks it but you.
ADMIN_SEED_PASSWORD=$ADMIN_SEED_PASSWORD
