# Secrets shared by every Kamal destination.
#
# DO NOT ENTER RAW CREDENTIALS HERE. This file is committed. Every line below
# reads a value from the deploying shell's environment; nothing is stored.
#
# Kamal reads two files per deploy, and the base .kamal/secrets is NOT one of
# them once a destination is given:
#
#   no destination  ->  .kamal/secrets-common  +  .kamal/secrets
#   -d staging      ->  .kamal/secrets-common  +  .kamal/secrets.staging
#
# Anything shared between destinations therefore has to live here.
#
# An unset variable resolves to an empty string rather than an error, so nothing
# here fails when a value is missing — Kamal writes `KEY=` into the container and
# the deploy breaks much further in. Check the values before deploying: see
# "Secrets" in docs/deployment/ovh-server-access.md.

# GitHub Container Registry token (a PAT with write:packages, or a GITHUB_TOKEN
# in CI).
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Decrypts config/credentials.yml.enc, which holds secret_key_base. The app
# cannot boot without it. Reads the local key file on a workstation and falls
# back to the environment for a CI deploy, where config/master.key is absent
# (.gitignore excludes config/*.key).
#
# Do not rewrite this as ${RAILS_MASTER_KEY:-$(cat config/master.key)}. Dotenv
# does not implement :- defaults, so that form resolves to the literal string
# ":-<key>}" and ships a master key that cannot decrypt anything.
RAILS_MASTER_KEY=$(cat config/master.key 2>/dev/null || printf %s "$RAILS_MASTER_KEY")

# Resend SMTP password. config/application.rb can fall back to the encrypted
# credential resend.api_key, but that key is absent from credentials, so this
# variable is currently mandatory.
RESEND_API_KEY=$RESEND_API_KEY

# Seeds both admin users via db/seeds.rb. At least 12 characters and at most
# 72 bytes — the two bounds are in different units and db/seeds.rb enforces both.
#
# An unusable value raises inside the container, after `db:prepare` has already
# created the databases, and a redeploy does NOT retry seeding. Recovery is a
# manual db:seed — see docs/deployment/ovh-server-access.md.
ADMIN_SEED_PASSWORD=$ADMIN_SEED_PASSWORD
