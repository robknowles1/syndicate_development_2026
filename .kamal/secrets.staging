# Committed file: never paste a real credential here — every line reads from the
# deploying shell. See "Secrets" in docs/deployment/ovh-server-access.md.

# Two names, not a duplicate to be deduped: POSTGRES_PASSWORD initialises the
# accessory, STAGING_DATABASE_PASSWORD authenticates the app against it.
STAGING_DATABASE_PASSWORD=$STAGING_DATABASE_PASSWORD
POSTGRES_PASSWORD=$STAGING_DATABASE_PASSWORD
