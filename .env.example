# Copy to .env and fill in. No real values belong in this file.
#
# Variables marked DEPLOY are read by Kamal from the deploying shell (via
# .kamal/secrets*), not by the app at runtime. Variables marked APP are injected
# into the container by config/deploy.yml and read by the Rails app at boot.
#
# Deploy procedure, per-destination secret checks and recovery are in
# docs/deployment/ovh-server-access.md.

# --- Seeding ---------------------------------------------------------------
# APP + DEPLOY. Seeds BOTH admin accounts (haskettd@live.com and
# robknowles105@gmail.com) with this as their initial password. The block runs
# only on create, so re-seeding never resets a password an admin has since
# changed.
#
# Must be at least 12 characters and at most 72 bytes. The two bounds are in
# different units on purpose: 12 is AdminUser::MINIMUM_PASSWORD_LENGTH, which the
# model validates in characters; 72 is bcrypt's input limit, which
# has_secure_password enforces in bytes. For an ASCII password they are the same
# number.
#
# Required before the first deploy, not only before running db:seed — `db:prepare`
# seeds the databases it creates. db/seeds.rb validates the value before writing
# anything and raises naming this variable if it is unset, blank, too short or
# too long.
ADMIN_SEED_PASSWORD=your_secure_password_here

# --- Mail ------------------------------------------------------------------
# APP + DEPLOY. Resend API key, used as the SMTP password. Falls back to the
# encrypted credentials key `resend.api_key` when unset. Production and staging
# refuse to boot if neither source supplies it.
RESEND_API_KEY=

# APP. Envelope sender. Must be a domain verified in Resend. Defaults to
# noreply@mail.syndicate-development.com when unset or empty.
MAIL_FROM_ADDRESS=

# APP. Where contact-form submissions land. Honoured ONLY when
# RAILS_ENV=production; every other environment mails the developer regardless
# of what is set here (config/mail_settings.rb). Leave unset to use the shop
# address in production.
CONTACT_RECIPIENT_EMAIL=

# --- Hosts -----------------------------------------------------------------
# APP. Canonical hostname used for mailer links and Host-header authorization. A
# Host not permitted by the environment file is rejected with 403, so confirm
# this matches the name DNS actually points at the app before deploying, and
# matches proxy.host in the Kamal config.
# Production default: www.syndicate-development.com
# Staging default:    staging.syndicate-development.com
APP_HOST=

# --- Database --------------------------------------------------------------
# APP. Staging runs a single primary database; see the notes in
# config/database.yml and config/deploy.staging.yml. The host is the Kamal
# accessory container's name on the shared `kamal` Docker network, not localhost.
STAGING_DATABASE_NAME=syndicate_development_2026_staging
STAGING_DATABASE_USER=syndicate_development_2026
STAGING_DATABASE_HOST=syndicate_development_2026-db-staging

# DEPLOY. Postgres password for the staging tier. Initialises the accessory and
# authenticates the app against it. Exported once; .kamal/secrets.staging fans it
# out to POSTGRES_PASSWORD and STAGING_DATABASE_PASSWORD.
STAGING_DATABASE_PASSWORD=

# DEPLOY. Same, for the production tier. Fanned out by .kamal/secrets.
PRODUCTION_DATABASE_PASSWORD=

# --- Runtime sizing --------------------------------------------------------
# APP. Sized for the 2 vCPU / 3.7 GB staging box. RAILS_MAX_THREADS sets both
# Puma's thread count and the Active Record pool, so these two together cap
# database connections at WEB_CONCURRENCY x RAILS_MAX_THREADS.
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5

# --- Logging ---------------------------------------------------------------
# APP. Defaults to "info" in production and "debug" in staging.
RAILS_LOG_LEVEL=

# --- Deploy ----------------------------------------------------------------
# DEPLOY. Decrypts config/credentials.yml.enc. Optional on a workstation that has
# config/master.key; mandatory for a CI deploy.
RAILS_MASTER_KEY=

# DEPLOY. GitHub Container Registry token — a PAT with write:packages.
KAMAL_REGISTRY_PASSWORD=

# DEPLOY. Production server address. Unset until production is provisioned via
# Kamal; config/deploy.yml falls back to a non-resolving placeholder so an
# accidental production deploy fails fast instead of hitting the staging box.
KAMAL_PRODUCTION_HOST=
