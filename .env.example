# Copy to .env and fill in. Every variable here is read at boot.

# --- Seeding ---------------------------------------------------------------
# Required before running db:seed. Use at least 12 characters — the admin
# password minimum rejects anything shorter, and `db:prepare` runs seeds during
# deploy, so a short value aborts the first deploy rather than failing quietly.
ADMIN_SEED_PASSWORD=your_secure_password_here

# --- Mail ------------------------------------------------------------------
# Resend API key, used as the SMTP password. Falls back to the encrypted
# credentials key `resend.api_key` when unset. Production and staging refuse to
# boot if neither source supplies it.
RESEND_API_KEY=

# Envelope sender. Must be a domain verified in Resend. Defaults to
# noreply@mail.syndicate-development.com when unset or empty.
MAIL_FROM_ADDRESS=

# Where contact-form submissions land. Honoured ONLY when RAILS_ENV=production.
# Kamal ships one config/deploy.yml for all environments, so a value set in its
# env.clear block would otherwise route staging to the customer as well; every
# non-production environment always mails the developer instead.
CONTACT_RECIPIENT_EMAIL=

# --- Hosts -----------------------------------------------------------------
# Canonical hostname used for mailer links and Host-header authorization. A Host
# not permitted by the environment file is rejected with 403, so confirm this
# matches the name DNS actually points at the app before deploying.
# Production default: www.syndicate-development.com
# Staging default:    staging.syndicate-development.com
APP_HOST=

# --- Staging database ------------------------------------------------------
# Staging runs a single primary database; see the note in config/database.yml.
STAGING_DATABASE_NAME=syndicate_development_2026_staging
STAGING_DATABASE_USER=syndicate_development_2026
STAGING_DATABASE_PASSWORD=
STAGING_DATABASE_HOST=localhost

# --- Logging ---------------------------------------------------------------
# Defaults to "info" in production and "debug" in staging.
RAILS_LOG_LEVEL=
