# Copy to .env and fill in there. This file is committed — keep it valueless.
# What each variable is for, and which ones a deploy needs, are in
# docs/deployment/ovh-server-access.md.

# --- Seeding ---------------------------------------------------------------
ADMIN_SEED_PASSWORD=your_secure_password_here

# --- Mail ------------------------------------------------------------------
RESEND_API_KEY=

MAIL_FROM_ADDRESS=

CONTACT_RECIPIENT_EMAIL=

# --- Hosts -----------------------------------------------------------------
APP_HOST=

# --- Database --------------------------------------------------------------
STAGING_DATABASE_NAME=syndicate_development_2026_staging
STAGING_DATABASE_USER=syndicate_development_2026
STAGING_DATABASE_HOST=syndicate_development_2026-db-staging

STAGING_DATABASE_PASSWORD=

PRODUCTION_DATABASE_PASSWORD=

# --- Runtime sizing --------------------------------------------------------
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5

# --- Logging ---------------------------------------------------------------
RAILS_LOG_LEVEL=

# --- Deploy ----------------------------------------------------------------
RAILS_MASTER_KEY=

KAMAL_REGISTRY_PASSWORD=

KAMAL_PRODUCTION_HOST=
