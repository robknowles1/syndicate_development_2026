<%= form_with model: [ :admin, social_media_link ], html: { class: "space-y-6" } do |f| %>
  <% if social_media_link.errors.any? %>
    <div class="bg-red-50 border border-red-300 rounded p-4">
      <ul class="list-disc list-inside text-red-700 text-sm space-y-1">
        <% social_media_link.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :platform, t("admin.social_media_links.platform_label"), class: "block text-sm font-semibold mb-1" %>
    <%= f.select :platform,
          SocialMediaLink::PLATFORMS.map { |platform| [ t("social_media.platforms.#{platform}"), platform ] },
          {},
          class: "w-full border border-gray-300 rounded px-3 py-3 focus:outline-none focus:ring-2 focus:ring-red-600" %>
  </div>

  <div>
    <%= f.label :url, t("admin.social_media_links.url_label"), class: "block text-sm font-semibold mb-1" %>
    <%= f.url_field :url, placeholder: t("admin.social_media_links.url_placeholder"),
          class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-600" %>
  </div>

  <div>
    <input type="hidden" name="social_media_link[active]" value="false">
    <label class="flex items-center gap-3 cursor-pointer">
      <input type="checkbox" name="social_media_link[active]" value="true"
             <%= "checked" if social_media_link.active? %>
             class="w-5 h-5 accent-red-600">
      <span class="font-semibold"><%= t("admin.social_media_links.active_label") %></span>
    </label>
    <p class="text-sm text-gray-500 mt-2"><%= t("admin.social_media_links.active_hint") %></p>
  </div>

  <%= f.submit t("admin.social_media_links.save"),
        class: "w-full md:w-auto bg-red-600 text-white font-bold py-3 px-6 rounded hover:bg-red-700 cursor-pointer" %>
<% end %>
