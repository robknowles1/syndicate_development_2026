<h1 class="text-2xl font-bold mb-6"><%= t("admin.home_page_content.heading") %></h1>

<section class="bg-white rounded-lg shadow p-4 md:p-6">
  <%= form_with model: [:admin, @home_page_content], url: admin_home_page_content_path, method: :patch, html: { class: "space-y-6" } do |f| %>
    <% if @home_page_content.errors.any? %>
      <div class="bg-red-50 border border-red-300 rounded p-4">
        <ul class="list-disc list-inside text-red-700 text-sm space-y-1">
          <% @home_page_content.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# Hero Tagline %>
    <div>
      <%= f.label :hero_tagline, t("admin.home_page_content.hero_tagline_label"),
            class: "block text-sm font-semibold mb-1" %>
      <%= f.text_field :hero_tagline,
            class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-600" %>
      <p class="text-sm text-gray-500 mt-1"><%= t("admin.home_page_content.hero_tagline_hint") %></p>
    </div>

    <%# Mission Heading %>
    <div>
      <%= f.label :mission_heading, t("admin.home_page_content.mission_heading_label"),
            class: "block text-sm font-semibold mb-1" %>
      <%= f.text_field :mission_heading,
            class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-600" %>
    </div>

    <%# Mission Subheading %>
    <div>
      <%= f.label :mission_subheading, t("admin.home_page_content.mission_subheading_label"),
            class: "block text-sm font-semibold mb-1" %>
      <%= f.text_field :mission_subheading,
            class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-600" %>
    </div>

    <%# Mission Body %>
    <div>
      <%= f.label :mission_body, t("admin.home_page_content.mission_body_label"),
            class: "block text-sm font-semibold mb-1" %>
      <%= f.text_area :mission_body, rows: 8,
            class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-600" %>
      <p class="text-sm text-gray-500 mt-1"><%= t("admin.home_page_content.mission_body_hint") %></p>
    </div>

    <%# Published toggle — matches services_pages/show.html.erb lines ~8-12 pattern %>
    <div>
      <input type="hidden" name="home_page_content[published]" value="false">
      <label class="flex items-center gap-3 cursor-pointer">
        <input type="checkbox" name="home_page_content[published]" value="true"
               <%= "checked" if @home_page_content.published? %>
               class="w-5 h-5 accent-red-600">
        <span class="font-semibold"><%= t("admin.home_page_content.published_label") %></span>
      </label>
      <p class="text-sm text-gray-500 mt-2"><%= t("admin.home_page_content.published_hint") %></p>
      <p class="text-sm text-gray-500 mt-1">
        <%= t("admin.home_page_content.current_status_label") %>
        <strong><%= @home_page_content.published? ? t("admin.home_page_content.status_published") : t("admin.home_page_content.status_unpublished") %></strong>
      </p>
    </div>

    <%# Actions %>
    <div class="flex flex-wrap gap-4 items-center">
      <%= f.submit t("admin.home_page_content.save"),
            class: "w-full md:w-auto bg-red-600 text-white font-bold py-3 px-6 rounded hover:bg-red-700 cursor-pointer" %>

      <%= link_to t("admin.home_page_content.restore_defaults_label"),
            restore_defaults_admin_home_page_content_path,
            data: { turbo_method: :patch, turbo_confirm: t("admin.home_page_content.confirm_restore_defaults") },
            class: "w-full md:w-auto inline-block text-center border-2 border-gray-400 text-gray-700 font-bold py-3 px-6 rounded hover:bg-gray-100 cursor-pointer" %>
    </div>
  <% end %>
</section>
