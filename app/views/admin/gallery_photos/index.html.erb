<h1 class="text-2xl font-bold mb-6"><%= t("admin.gallery_photos.heading") %></h1>

<section class="bg-white rounded-lg shadow p-4 md:p-6 mb-6">
  <%= form_with model: [ :admin, @gallery_photo ], html: { class: "w-full" } do |f| %>
    <% if @gallery_photo.errors.any? %>
      <div class="bg-red-50 border border-red-300 rounded p-4 mb-4">
        <ul class="list-disc list-inside text-red-700 text-sm space-y-1">
          <% @gallery_photo.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="w-full">
      <%= f.label :image, t("admin.gallery_photos.image_label"), class: "block text-sm font-semibold mb-1" %>
      <%= f.file_field :image, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      <p class="mt-1 text-xs text-gray-500"><%= t("admin.gallery_photos.image_hint") %></p>
    </div>

    <%= f.submit t("admin.gallery_photos.save"),
          class: "mt-4 w-full md:w-auto bg-red-600 text-white font-bold py-3 px-5 rounded hover:bg-red-700 cursor-pointer" %>
  <% end %>
</section>

<section class="bg-white rounded-lg shadow p-4 md:p-6">
  <% if @photos.empty? %>
    <p class="text-gray-500 italic"><%= t("admin.gallery_photos.empty_state") %></p>
  <% else %>
    <ul class="divide-y divide-gray-100">
      <% @photos.each do |photo| %>
        <li class="py-4 first:pt-0 last:pb-0">
          <div class="mb-3">
            <%= image_tag photo.display_variant,
                  alt: t("pages.gallery.photo_alt"),
                  class: "w-24 h-24 object-cover rounded" %>
          </div>

          <div class="flex flex-wrap gap-2">
            <%= link_to t("admin.gallery_photos.move_up"),
                  move_up_admin_gallery_photo_path(photo),
                  data: { turbo_method: :patch },
                  class: "text-sm bg-gray-100 hover:bg-gray-200 px-3 py-2 rounded font-semibold" %>
            <%= link_to t("admin.gallery_photos.move_down"),
                  move_down_admin_gallery_photo_path(photo),
                  data: { turbo_method: :patch },
                  class: "text-sm bg-gray-100 hover:bg-gray-200 px-3 py-2 rounded font-semibold" %>
            <%= link_to t("admin.gallery_photos.delete"),
                  admin_gallery_photo_path(photo),
                  data: { turbo_method: :delete, turbo_confirm: t("admin.gallery_photos.confirm_delete") },
                  class: "text-sm font-semibold px-3 py-2 rounded text-red-600 hover:text-red-800 bg-red-50 hover:bg-red-100" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
