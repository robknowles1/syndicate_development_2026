<div class="max-w-md mx-auto mt-8 md:mt-16 bg-white rounded-lg shadow p-5 md:p-8">
  <h1 class="text-2xl font-bold mb-2 text-center"><%= t("admin.password_reset.heading") %></h1>
  <p class="text-sm text-gray-600 mb-6 text-center"><%= t("admin.password_reset.intro") %></p>

  <%= form_with url: admin_password_reset_path, method: :post, class: "space-y-5" do |f| %>
    <div>
      <%= label_tag :email, t("admin.password_reset.email_label"), class: "block text-sm font-semibold mb-1" %>
      <%= text_field_tag :email, params[:email], type: "email", required: true, autofocus: true,
            autocomplete: "email",
            class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-600" %>
    </div>

    <%= submit_tag t("admin.password_reset.submit"),
          class: "w-full bg-red-600 text-white font-bold py-3 px-4 rounded hover:bg-red-700 cursor-pointer" %>
  <% end %>

  <p class="mt-6 text-center">
    <%= link_to t("admin.password_reset.back_to_login"), admin_login_path,
          class: "inline-block text-sm text-red-600 hover:text-red-800 font-semibold py-3 px-4" %>
  </p>
</div>
