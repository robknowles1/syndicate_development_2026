<h1 class="text-2xl font-bold mb-8"><%= t("admin.services_page.heading") %></h1>

<%# ---- Published toggle ---- %>
<section class="bg-white rounded-lg shadow p-6 mb-8">
  <h2 class="text-lg font-semibold mb-4"><%= t("admin.services_page.visibility_heading") %></h2>
  <%= form_with url: admin_services_page_path, method: :patch, html: { id: "toggle-form" } do |f| %>
    <%# Hidden field ensures "false" is sent when checkbox is unchecked %>
    <input type="hidden" name="published" value="false">
    <label class="flex items-center gap-3 cursor-pointer">
      <input type="checkbox" name="published" value="true" <%= "checked" if @published %>
             class="w-5 h-5 accent-red-600">
      <span class="font-semibold"><%= t("admin.services_page.published_label") %></span>
    </label>
    <p class="text-sm text-gray-500 mt-2">
      <%= t("admin.services_page.current_status_label") %> <strong><%= @published ? t("admin.services_page.status_published") : t("admin.services_page.status_unpublished") %></strong>
    </p>
    <%= submit_tag t("admin.services_page.save"), class: "mt-4 bg-red-600 text-white font-bold py-2 px-5 rounded hover:bg-red-700 cursor-pointer" %>
  <% end %>
</section>

<%# ---- Section list ---- %>
<section class="bg-white rounded-lg shadow p-6">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-lg font-semibold"><%= t("admin.services_page.sections_heading") %></h2>
    <%= link_to t("admin.service_sections.add_first"), new_admin_service_section_path,
          class: "bg-red-600 text-white font-bold py-2 px-4 rounded hover:bg-red-700 text-sm" %>
  </div>

  <% if @sections.empty? %>
    <p class="text-gray-500 italic"><%= t("admin.service_sections.empty_state") %></p>
    <p class="mt-2">
      <%= link_to t("admin.service_sections.add_first"), new_admin_service_section_path,
            class: "text-red-600 font-bold hover:text-red-800" %>
    </p>
  <% else %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b text-left text-gray-500">
          <th class="pb-2 pr-4"><%= t("admin.services_page.col_icon") %></th>
          <th class="pb-2 pr-4"><%= t("admin.services_page.col_heading") %></th>
          <th class="pb-2 pr-4"><%= t("admin.services_page.col_bullets") %></th>
          <th class="pb-2"><%= t("admin.services_page.col_actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @sections.each do |section| %>
          <tr class="border-b last:border-b-0">
            <td class="py-3 pr-4 w-10 text-gray-600">
              <%= heroicon section.icon_key, variant: :outline, options: { class: "w-6 h-6" } %>
            </td>
            <td class="py-3 pr-4 font-semibold"><%= section.heading %></td>
            <td class="py-3 pr-4 text-gray-500"><%= section.service_bullets.size %></td>
            <td class="py-3">
              <div class="flex items-center gap-2 flex-wrap">
                <%# Move controls — link_to avoids <form> inside <td> which browsers silently discard %>
                <%= link_to t("admin.service_sections.move_up"),
                      move_up_admin_service_section_path(section),
                      data: { turbo_method: :patch },
                      class: "text-xs bg-gray-100 hover:bg-gray-200 px-2 py-1 rounded font-semibold" %>
                <%= link_to t("admin.service_sections.move_down"),
                      move_down_admin_service_section_path(section),
                      data: { turbo_method: :patch },
                      class: "text-xs bg-gray-100 hover:bg-gray-200 px-2 py-1 rounded font-semibold" %>

                <%# Edit control %>
                <%= link_to t("admin.service_sections.edit"),
                      edit_admin_service_section_path(section),
                      class: "text-xs bg-blue-100 hover:bg-blue-200 px-2 py-1 rounded font-semibold ml-4" %>

                <%# Delete control — visually separated and red %>
                <%= link_to t("admin.service_sections.delete"),
                      admin_service_section_path(section),
                      data: { turbo_method: :delete, turbo_confirm: t("admin.service_sections.confirm_delete") },
                      class: "text-xs font-semibold px-2 py-1 rounded ml-4 text-red-600 hover:text-red-800 bg-red-50 hover:bg-red-100" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
