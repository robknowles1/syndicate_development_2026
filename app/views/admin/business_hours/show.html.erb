<h1 class="text-2xl font-bold mb-6"><%= t("admin.business_hours.heading") %></h1>

<section class="bg-white rounded-lg shadow p-4 md:p-6 max-w-2xl">
  <%= form_with model: @business_hours, url: admin_business_hours_path, method: :patch, html: { class: "space-y-6" } do |f| %>
    <% if @business_hours.errors.any? %>
      <div class="bg-red-50 border border-red-300 rounded p-4">
        <ul class="list-disc list-inside text-red-700 text-sm space-y-1">
          <% @business_hours.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <p class="text-sm text-gray-500"><%= t("admin.business_hours.hint") %></p>

    <% BusinessHours::DAYS.each do |day| %>
      <fieldset>
        <legend class="block text-sm font-semibold mb-1"><%= t("admin.business_hours.day_#{day}") %></legend>
        <div class="flex flex-col sm:flex-row gap-3">
          <div class="flex-1">
            <%= f.label :"#{day}_opens_at", t("admin.business_hours.opens_label"),
                  class: "block text-xs text-gray-500 mb-1" %>
            <%= f.time_field :"#{day}_opens_at", include_seconds: false,
                  class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-600" %>
          </div>
          <div class="flex-1">
            <%= f.label :"#{day}_closes_at", t("admin.business_hours.closes_label"),
                  class: "block text-xs text-gray-500 mb-1" %>
            <%= f.time_field :"#{day}_closes_at", include_seconds: false,
                  class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-600" %>
          </div>
        </div>
      </fieldset>
    <% end %>

    <%= f.submit t("admin.business_hours.save"),
          class: "w-full md:w-auto bg-red-600 text-white font-bold py-3 px-6 rounded hover:bg-red-700 cursor-pointer" %>
  <% end %>
</section>
