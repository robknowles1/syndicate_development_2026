<div class="max-w-md mx-auto bg-white rounded-lg shadow p-5 md:p-8">
  <h1 class="text-2xl font-bold mb-2"><%= t("admin.account.heading") %></h1>
  <p class="text-sm text-gray-600 mb-6"><%= @admin_user.email %></p>

  <%= form_with model: @admin_user, url: admin_account_path, method: :patch, scope: :admin_user, class: "space-y-5" do |f| %>
    <% if @admin_user.errors.any? %>
      <div class="bg-red-50 border border-red-300 text-red-800 rounded px-4 py-3" role="alert">
        <ul class="list-disc list-inside text-sm">
          <% @admin_user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :current_password, t("admin.account.current_password_label"), class: "block text-sm font-semibold mb-1" %>
      <%= f.password_field :current_password, required: true, autofocus: true, autocomplete: "current-password",
            class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-600" %>
    </div>

    <div>
      <%= f.label :password, t("admin.account.new_password_label"), class: "block text-sm font-semibold mb-1" %>
      <%= f.password_field :password, required: true, autocomplete: "new-password",
            class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-600" %>
      <p class="text-xs text-gray-500 mt-1"><%= t("admin.password_fields.password_hint", count: AdminUser::MINIMUM_PASSWORD_LENGTH) %></p>
    </div>

    <div>
      <%= f.label :password_confirmation, t("admin.password_fields.confirmation_label"), class: "block text-sm font-semibold mb-1" %>
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password",
            class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-600" %>
    </div>

    <%= f.submit t("admin.account.submit"),
          class: "w-full bg-red-600 text-white font-bold py-3 px-4 rounded hover:bg-red-700 cursor-pointer" %>
  <% end %>
</div>
