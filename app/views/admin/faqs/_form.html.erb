<%= form_with model: [ :admin, faq ], html: { class: "space-y-6" } do |f| %>
  <% if faq.errors.any? %>
    <div class="bg-red-50 border border-red-300 rounded p-4">
      <ul class="list-disc list-inside text-red-700 text-sm space-y-1">
        <% faq.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :question, t("admin.faqs.question_label"), class: "block text-sm font-semibold mb-1" %>
    <%= f.text_field :question,
          class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-600" %>
  </div>

  <div>
    <%= f.label :answer, t("admin.faqs.answer_label"), class: "block text-sm font-semibold mb-1" %>
    <%= f.text_area :answer, rows: 8,
          class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-600" %>
  </div>

  <%= f.submit t("admin.faqs.save"),
        class: "w-full md:w-auto bg-red-600 text-white font-bold py-3 px-6 rounded hover:bg-red-700 cursor-pointer" %>
<% end %>
