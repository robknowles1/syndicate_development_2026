<div class="max-w-md mx-auto bg-white rounded-lg shadow p-5 md:p-8">
  <h1 class="text-2xl font-bold mb-2"><%= t("admin.users.invite_heading") %></h1>
  <p class="text-sm text-gray-600 mb-6"><%= t("admin.users.invite_intro") %></p>

  <%= form_with model: @admin_user, url: admin_users_path, scope: :admin_user, class: "space-y-5" do |f| %>
    <% if @admin_user.errors.any? %>
      <div class="bg-red-50 border border-red-300 text-red-800 rounded px-4 py-3" role="alert">
        <ul class="list-disc list-inside text-sm">
          <% @admin_user.errors.full_messages_for(:email).each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :email, t("admin.users.email_label"), class: "block text-sm font-semibold mb-1" %>
      <%= f.email_field :email, required: true, autofocus: true, autocomplete: "off",
            class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-600" %>
    </div>

    <%= f.submit t("admin.users.invite_submit"),
          class: "w-full bg-red-600 text-white font-bold py-3 px-4 rounded hover:bg-red-700 cursor-pointer" %>
  <% end %>

  <p class="mt-6">
    <%= link_to t("admin.users.back"), admin_users_path,
          class: "inline-block text-sm text-red-600 hover:text-red-800 font-semibold py-3 px-4" %>
  </p>
</div>
