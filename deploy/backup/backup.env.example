# Installed as /etc/syndicate-backup/backup.env (root:root, 0600).
# Holds no credentials: the database password is read from the running Postgres
# container and the R2 token lives in rclone.conf.
#
# Repointing this file at production is the whole of the Phase 5 change — the
# scripts, units and timers are unchanged. Production values are commented below.

BACKUP_DESTINATION=staging
PG_CONTAINER=syndicate_development_2026-db-staging
PG_DATABASE=syndicate_development_2026_staging
PG_USER=syndicate_development_2026
STORAGE_VOLUME=syndicate_development_2026_staging_storage
WEB_CONTAINER_PREFIX=syndicate_development_2026-web-staging

# BACKUP_DESTINATION=production
# PG_CONTAINER=syndicate_development_2026-db
# PG_DATABASE=syndicate_development_2026_production
# PG_USER=syndicate_development_2026
# STORAGE_VOLUME=syndicate_development_2026_storage
# WEB_CONTAINER_PREFIX=syndicate_development_2026-web

# Pinned, and pre-pulled by install.sh. A floating tag turns the 09:17 run into a
# Docker Hub pull, which anonymous rate limits can fail.
ARCHIVE_IMAGE=alpine:3.21

R2_REMOTE=r2
R2_BUCKET=syndicate-backups

DAILY_RETENTION_DAYS=30
MONTHLY_RETENTION_DAYS=400
