# Installed as /etc/syndicate-backup/backup.env (root:root, 0600).
# Runbook: docs/deployment/ovh-server-access.md#backups.
#
# Holds no credentials. The database password is read from the running Postgres
# container and the R2 token lives in rclone.conf; adding either here creates a
# second copy that goes stale on rotation.
#
# This is the only tier config. syndicate-backup, syndicate-backup-verify and
# syndicate-backup-drill all read it, which is what keeps the verifier watching
# the tier that is actually backed up. Do not add a per-tier file and select it
# with BACKUP_CONFIG= on one unit: the verifier would go on checking whichever
# tier it was left pointing at and keep passing while the backed-up tier rotted.
#
# Staging is deliberately absent, not forgotten — it is reproducible from
# production and the owner asked for production only.

BACKUP_DESTINATION=production
PG_CONTAINER=syndicate_development_2026-db
PG_DATABASE=syndicate_development_2026_production
PG_USER=syndicate_development_2026
STORAGE_VOLUME=syndicate_development_2026_storage
WEB_CONTAINER_PREFIX=syndicate_development_2026-web

# Pinned, and pre-pulled by install.sh. A floating tag turns the nightly run into
# a Docker Hub pull, which anonymous rate limits can fail.
ARCHIVE_IMAGE=alpine:3.21

R2_REMOTE=r2
R2_BUCKET=syndicate-backups

DAILY_RETENTION_DAYS=30
MONTHLY_RETENTION_DAYS=400
