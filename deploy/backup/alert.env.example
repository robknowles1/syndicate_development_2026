# Installed as /etc/syndicate-backup/alert.env (root:root, 0600).
#
# REAL VALUES ARE NEVER COMMITTED. install.sh copies this file verbatim, leaving
# RESEND_API_KEY as the placeholder below so an unpopulated alert channel fails
# loudly (syndicate-backup-alert exits non-zero, and the weekly verifier reports
# it) rather than silently swallowing a backup failure.
#
# To populate, on the box:
#   sudo install -m 600 -o root -g root /dev/stdin /etc/syndicate-backup/alert.env <<'EOF'
#   RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
#   ALERT_FROM_ADDRESS="Syndicate Backups <noreply@mail.syndicate-development.com>"
#   ALERT_TO_ADDRESS=robknowles105@gmail.com
#   EOF
# The key is the same Resend key Kamal already injects into the app container; it
# is copied here because systemd runs on the host, outside that container.

RESEND_API_KEY=REPLACE_ME

# SPEC-017 Phase 4 retires mail.syndicate-development.com. Alerting follows by
# editing this line — it is deliberately not derived from the app's constants.
ALERT_FROM_ADDRESS="Syndicate Backups <noreply@mail.syndicate-development.com>"

ALERT_TO_ADDRESS=robknowles105@gmail.com
